syntax = "proto3";

package {{ .WirePackage }};

option go_package = "{{ .ModulePath }}/api/gen/go/{{ .Leaf }}/{{ .Version }};{{ .GenPkgName }}";

service {{ .ServiceName }} {
{{- range .RPCs }}
  {{ .Line }}
{{- end }}
}
{{ range .Messages }}
message {{ .Request }} {
}

message {{ .Response }} {
}
{{ end }}
