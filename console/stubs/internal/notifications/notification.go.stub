package {{ .Package }}

import (
	"github.com/velocitykode/velocity/notification"
)

// {{ .Name }} notification
type {{ .Name }} struct {
	// Add notification data fields here
}

// Via returns the channels this notification should be delivered through.
func (n {{ .Name }}) Via(notifiable interface{}) []string {
	return []string{"mail"}
}

// ToMail builds the mail representation of the notification.
func (n {{ .Name }}) ToMail(notifiable interface{}) *notification.MailMessage {
	return notification.NewMailMessage().
		Subject("{{ .Name }}").
		Line("You have a new notification.")
}

